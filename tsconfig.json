{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "three128": [
        "./node_modules/three"
      ],
      "@designcodeio/threeui": [
        "./src/shaders/threeui-index.tsx"
      ],
      "@designcodeio/threeui/*": [
        "./src/shaders/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
